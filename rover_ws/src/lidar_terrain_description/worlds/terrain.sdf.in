<?xml version="1.0"?>
<sdf version="1.9">
 <world name="stl_terrain">
  <physics name="physics" type="ignored"><max_step_size>0.001</max_step_size><real_time_factor>1</real_time_factor></physics>
  <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
  <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
  <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
  <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
  <scene><ambient>0.5 0.5 0.5 1</ambient><background>0.6 0.7 0.8 1</background></scene>
  <light name="sun" type="directional"><pose>0 0 100 0 0 0</pose><diffuse>0.8 0.8 0.8 1</diffuse><specular>0.2 0.2 0.2 1</specular><direction>-0.3 0.1 -0.9</direction><cast_shadows>true</cast_shadows></light>
  <model name="terrain"><static>true</static><link name="terrain_surface">
   <visual name="surface"><geometry><mesh><uri>@MESH@</uri><scale>@SCALE@ @SCALE@ @SCALE@</scale></mesh></geometry><material><ambient>0.65 0.52 0.33 1</ambient><diffuse>0.65 0.52 0.33 1</diffuse></material></visual>
   <collision name="surface"><geometry><mesh><uri>@MESH@</uri><scale>@SCALE@ @SCALE@ @SCALE@</scale></mesh></geometry></collision>
  </link></model>
  <model name="stationary_scanner"><static>true</static><pose>@X@ @Y@ @Z@ 0 0 0</pose><link name="terrain_sim_lidar">
   <sensor name="generic_3d_lidar" type="gpu_lidar">
    <topic>/terrain_lidar</topic><gz_frame_id>terrain_sim_lidar</gz_frame_id><always_on>true</always_on><update_rate>5</update_rate><visualize>false</visualize>
    <lidar><scan><horizontal><samples>720</samples><resolution>1</resolution><min_angle>-3.141592653589793</min_angle><max_angle>3.141592653589793</max_angle></horizontal><vertical><samples>64</samples><resolution>1</resolution><min_angle>-1.5707</min_angle><max_angle>0.261799</max_angle></vertical></scan><range><min>0.1</min><max>30</max><resolution>0.01</resolution></range></lidar>
   </sensor>
  </link></model>
 </world>
</sdf>
