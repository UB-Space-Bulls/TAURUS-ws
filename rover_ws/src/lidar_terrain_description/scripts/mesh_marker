#!/usr/bin/env python3
import math
import rclpy
from rclpy.node import Node
from rclpy.qos import QoSProfile, DurabilityPolicy, ReliabilityPolicy
from visualization_msgs.msg import Marker

class MeshMarker(Node):
    def __init__(self):
        super().__init__('terrain_mesh_preview')
        self.declare_parameter('mesh', 'tile')
        self.declare_parameter('scale', 1.0)
        variant=self.get_parameter('mesh').value
        scale=float(self.get_parameter('scale').value)
        if variant not in ('tile','overview') or not math.isfinite(scale) or scale <= 0:
            raise ValueError('mesh must be tile/overview and scale must be positive and finite')
        self.pub=self.create_publisher(Marker,'/terrain_scene/mesh',QoSProfile(depth=1,
            durability=DurabilityPolicy.TRANSIENT_LOCAL,reliability=ReliabilityPolicy.RELIABLE))
        self.msg=Marker()
        self.msg.header.frame_id='terrain_map'
        self.msg.ns='terrain_scene'; self.msg.id=0
        self.msg.type=Marker.MESH_RESOURCE; self.msg.action=Marker.ADD
        self.msg.mesh_resource=f'package://lidar_terrain_description/meshes/terrain_{variant}.stl'
        self.msg.pose.orientation.w=1.0
        self.msg.scale.x=self.msg.scale.y=self.msg.scale.z=scale
        self.msg.color.r=.65; self.msg.color.g=.52; self.msg.color.b=.33; self.msg.color.a=1.0
        self.timer=self.create_timer(1.0,self.publish)
    def publish(self):
        self.msg.header.stamp=self.get_clock().now().to_msg()
        self.pub.publish(self.msg)

def main():
    rclpy.init(); node=MeshMarker()
    try: rclpy.spin(node)
    except KeyboardInterrupt: pass
    finally:
        node.destroy_node()
        if rclpy.ok(): rclpy.shutdown()
if __name__=='__main__': main()
