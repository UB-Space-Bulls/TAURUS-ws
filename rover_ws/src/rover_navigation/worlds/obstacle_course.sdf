<?xml version="1.0"?>
<sdf version="1.9">
  <world name="fastlio_obstacle_course">
    <physics name="physics" type="ignored"><max_step_size>0.001</max_step_size><real_time_factor>1</real_time_factor></physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <scene><ambient>0.6 0.6 0.6 1</ambient><background>0.6 0.7 0.8 1</background></scene>
    <light name="sun" type="directional"><pose>0 0 10 0 0 0</pose><diffuse>0.8 0.8 0.8 1</diffuse><direction>-0.3 0.1 -0.9</direction></light>
    <model name="level_floor"><static>true</static><link name="floor">
      <collision name="floor"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry></collision>
      <visual name="floor"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry><material><ambient>0.55 0.48 0.36 1</ambient><diffuse>0.55 0.48 0.36 1</diffuse></material></visual>
    </link></model>
    <!-- Real collision and ray-casting geometry. No map/cost injection. -->
    <model name="navigation_obstacle"><static>true</static><pose>2 0 0.4 0 0 0</pose><link name="box">
      <collision name="box"><geometry><box><size>0.8 0.8 0.8</size></box></geometry></collision>
      <visual name="box"><geometry><box><size>0.8 0.8 0.8</size></box></geometry><material><ambient>1 0.3 0.05 1</ambient><diffuse>1 0.3 0.05 1</diffuse></material></visual>
    </link></model>
    <!-- Stationary walls make XY/yaw observable to scan matching. -->
    <model name="north_wall"><static>true</static><pose>0 8 1.5 0 0 0</pose><link name="wall"><collision name="wall"><geometry><box><size>16 0.2 3</size></box></geometry></collision><visual name="wall"><geometry><box><size>16 0.2 3</size></box></geometry></visual></link></model>
    <model name="south_wall"><static>true</static><pose>0 -8 1.5 0 0 0</pose><link name="wall"><collision name="wall"><geometry><box><size>16 0.2 3</size></box></geometry></collision><visual name="wall"><geometry><box><size>16 0.2 3</size></box></geometry></visual></link></model>
    <model name="east_wall"><static>true</static><pose>8 0 1.5 0 0 0</pose><link name="wall"><collision name="wall"><geometry><box><size>0.2 16 3</size></box></geometry></collision><visual name="wall"><geometry><box><size>0.2 16 3</size></box></geometry></visual></link></model>
    <model name="west_wall"><static>true</static><pose>-8 0 1.5 0 0 0</pose><link name="wall"><collision name="wall"><geometry><box><size>0.2 16 3</size></box></geometry></collision><visual name="wall"><geometry><box><size>0.2 16 3</size></box></geometry></visual></link></model>
  </world>
</sdf>
