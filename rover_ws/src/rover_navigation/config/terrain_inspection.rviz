Panels:
- Class: rviz_common/Displays
  Name: Displays
- Class: nav2_rviz_plugins/Navigation 2
  Name: Navigation 2
- Class: rviz_common/Views
  Name: Views
Visualization Manager:
  Class: ''
  Global Options:
    Fixed Frame: odom
    Background Color: 35; 40; 48
    Frame Rate: 30
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Reference grid
    Enabled: true
    Cell Size: 1
    Plane Cell Count: 20
  - Class: rviz_default_plugins/Marker
    Name: STL terrain
    Enabled: true
    Topic:
      Value: /terrain_scene/mesh
      Depth: 1
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Transient Local
  - Class: rviz_default_plugins/PointCloud2
    Name: Terrain geometry - rainbow height (m)
    Enabled: true
    Topic:
      Value: /terrain/grid_points
      Depth: 1
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Volatile
    Style: Spheres
    Size (m): 0.16
    Alpha: 1
    Decay Time: 0
    Position Transformer: XYZ
    Color Transformer: Intensity
    Channel Name: z
    Use rainbow: true
    Invert Rainbow: false
    Autocompute Intensity Bounds: true
  - Class: rviz_default_plugins/PointCloud2
    Name: Terrain geometry - rainbow slope (deg)
    Enabled: false
    Topic:
      Value: /terrain/grid_points
      Depth: 1
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Volatile
    Style: Spheres
    Size (m): 0.16
    Alpha: 1
    Decay Time: 0
    Position Transformer: XYZ
    Color Transformer: Intensity
    Channel Name: slope_deg
    Use rainbow: true
    Invert Rainbow: false
    Autocompute Intensity Bounds: false
    Min Intensity: 0
    Max Intensity: 20
  - Class: rviz_default_plugins/PointCloud2
    Name: Terrain geometry - rainbow roughness (m)
    Enabled: false
    Topic:
      Value: /terrain/grid_points
      Depth: 1
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Volatile
    Style: Spheres
    Size (m): 0.16
    Alpha: 1
    Decay Time: 0
    Position Transformer: XYZ
    Color Transformer: Intensity
    Channel Name: roughness_m
    Use rainbow: true
    Invert Rainbow: false
    Autocompute Intensity Bounds: false
    Min Intensity: 0
    Max Intensity: 0.06
  - Class: rviz_default_plugins/PointCloud2
    Name: Ground returns - rainbow height (optional)
    Enabled: false
    Topic:
      Value: /terrain/ground_points
      Depth: 1
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Volatile
    Style: Points
    Size (m): 0.16
    Alpha: 1
    Decay Time: 0
    Position Transformer: XYZ
    Color Transformer: Intensity
    Channel Name: z
    Use rainbow: true
    Invert Rainbow: false
    Autocompute Intensity Bounds: true
    Size (Pixels): 3
  - Class: rviz_default_plugins/PointCloud2
    Name: Detected obstacle returns (red)
    Enabled: true
    Topic:
      Value: /terrain/obstacle_points
      Depth: 1
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Volatile
    Style: Points
    Size (m): 0.16
    Alpha: 1
    Decay Time: 0
    Position Transformer: XYZ
    Color Transformer: FlatColor
    Channel Name: z
    Use rainbow: true
    Invert Rainbow: false
    Autocompute Intensity Bounds: true
    Size (Pixels): 3
    Color: 245; 65; 55
  - Class: rviz_default_plugins/PointCloud2
    Name: Raw LiDAR returns (optional)
    Enabled: false
    Topic:
      Value: /rover/lidar/points
      Depth: 1
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Durability Policy: Volatile
    Style: Points
    Size (Pixels): 3
    Position Transformer: XYZ
    Color Transformer: AxisColor
    Axis: Z
    Decay Time: 0
  - Class: rviz_default_plugins/TF
    Name: Frames
    Enabled: false
  - Class: rviz_default_plugins/Map
    Name: Terrain costs
    Enabled: false
    Alpha: 0.65
    Color Scheme: costmap
    Draw Behind: false
    Topic:
      Value: /terrain_cost_grid
      Depth: 1
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Transient Local
  - Class: rviz_default_plugins/Map
    Name: Global costmap
    Enabled: false
    Alpha: 0.65
    Color Scheme: costmap
    Draw Behind: false
    Topic:
      Value: /global_costmap/costmap
      Depth: 1
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Transient Local
  - Class: rviz_default_plugins/Map
    Name: Local costmap
    Enabled: false
    Alpha: 0.65
    Color Scheme: costmap
    Draw Behind: false
    Topic:
      Value: /local_costmap/costmap
      Depth: 1
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Transient Local
  - Class: rviz_default_plugins/LaserScan
    Name: Obstacle scan
    Enabled: false
    Topic:
      Value: /scan
      Reliability Policy: Best Effort
      Durability Policy: Volatile
      Depth: 1
    Size (Pixels): 4
    Style: Points
    Position Transformer: XYZ
    Color Transformer: FlatColor
    Color: 255; 80; 60
  - Class: rviz_default_plugins/RobotModel
    Name: Rover
    Enabled: true
    Description Source: Topic
    Description Topic:
      Value: /robot_description
      Durability Policy: Transient Local
      Reliability Policy: Reliable
  - Class: rviz_default_plugins/Path
    Name: Global path
    Enabled: true
    Topic:
      Value: /plan
      Durability Policy: Volatile
      Reliability Policy: Reliable
    Color: 25; 255; 80
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Terrain inspection
      Distance: 22
      Pitch: 0.8
      Yaw: 0.6
      Target Frame: base_link
      Focal Point:
        X: 0
        Y: 0
        Z: -0.2
    Saved:
    - Class: rviz_default_plugins/Orbit
      Name: Processed terrain close-up
      Distance: 12
      Pitch: 0.8
      Yaw: 0.6
      Target Frame: base_link
      Focal Point:
        X: 0
        Y: 0
        Z: -0.2
    - Class: rviz_default_plugins/Orbit
      Name: Full STL tile
      Distance: 85
      Pitch: 0.8
      Yaw: 0.6
      Target Frame: base_link
      Focal Point:
        X: 0
        Y: 0
        Z: -0.2
  Tools:
  - Class: rviz_default_plugins/Interact
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: nav2_rviz_plugins/GoalTool
Window Geometry:
  Width: 1280
  Height: 800
