<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.9">
  <world name="terrain_demo">
    <physics name="physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu" />
    <gravity>0 0 -9.81</gravity>
    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    <model name="flat_ground">
      <static>true</static>
      <pose>0 0 -0.1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>30 30 0.2</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>30 30 0.2</size>
            </box>
          </geometry>
          <material>
            <ambient>0.55 0.50 0.40 1</ambient>
            <diffuse>0.55 0.50 0.40 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="ramp_15_degrees">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <mesh>
              <uri>model://terrain_geometry/meshes/ramp.stl</uri>
            </mesh>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <mesh>
              <uri>model://terrain_geometry/meshes/ramp.stl</uri>
            </mesh>
          </geometry>
          <material>
            <ambient>0.20 0.55 0.75 1</ambient>
            <diffuse>0.20 0.55 0.75 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="uneven_ground">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <mesh>
              <uri>model://terrain_geometry/meshes/rough.stl</uri>
            </mesh>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <mesh>
              <uri>model://terrain_geometry/meshes/rough.stl</uri>
            </mesh>
          </geometry>
          <material>
            <ambient>0.55 0.35 0.20 1</ambient>
            <diffuse>0.55 0.35 0.20 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="raised_obstacle_0_7m">
      <static>true</static>
      <pose>3.5 0 0.35 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.9 1.0 0.7</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.9 1.0 0.7</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.2 0.15 1</ambient>
            <diffuse>0.8 0.2 0.15 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="stationary_unitree_l1_rm">
      <static>true</static>
      <pose>0 0 1.2 3.141592653589793 0 0</pose>
      <link name="unilidar_lidar">
        <sensor name="unitree_l1_approximation" type="gpu_lidar">
          <topic>/unilidar</topic>
          <gz_frame_id>unilidar_lidar</gz_frame_id>
          <always_on>true</always_on>
          <update_rate>1.0</update_rate>
          <visualize>false</visualize>
          <lidar>
            <scan>
              <horizontal>
                <samples>240</samples>
                <resolution>1</resolution>
                <min_angle>-3.141592653589793</min_angle>
                <max_angle>3.141592653589793</max_angle>
              </horizontal>
              <vertical>
                <samples>90</samples>
                <resolution>1</resolution>
                <min_angle>0.0</min_angle>
                <max_angle>1.5707963267948966</max_angle>
              </vertical>
            </scan>
            <range>
              <min>0.05</min>
              <max>30.0</max>
              <resolution>0.008</resolution>
            </range>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.01</stddev>
            </noise>
          </lidar>
        </sensor>
        <sensor name="unitree_l1_imu_approximation" type="imu">
          <pose>-0.007698 -0.014655 0.00667 0 0 0</pose>
          <topic>/unilidar/imu</topic>
          <gz_frame_id>unilidar_imu</gz_frame_id>
          <always_on>true</always_on>
          <update_rate>250.0</update_rate>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
