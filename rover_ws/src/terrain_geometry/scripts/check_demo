#!/usr/bin/env python3
"""Live demo checker; implementation is installed beside this file."""
from pathlib import Path
import sys

source_root = Path(__file__).resolve().parents[1]
if (source_root / 'terrain_geometry_impl').is_dir():
    sys.path.insert(0, str(source_root))
from terrain_geometry_impl.check_demo import main

if __name__ == '__main__':
    main()
