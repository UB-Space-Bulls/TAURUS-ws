#!/usr/bin/env python3
"""Write a measured stationary mounting file, asking for one value at a time."""
import argparse
import math
from pathlib import Path
import sys
import yaml

source_root = Path(__file__).resolve().parents[1]
if (source_root / 'terrain_geometry_impl').is_dir():
    sys.path.insert(0, str(source_root))
from terrain_geometry_impl.hardware import validate_mount


def ask_number(prompt):
    while True:
        text = input(prompt).strip()
        try:
            value = float(text)
            if math.isfinite(value):
                return value
        except ValueError:
            pass
        print('Enter one finite number; angles must be decimal radians.')


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--output', default='~/l1_mount.yaml')
    parser.add_argument('--force', action='store_true', help='Replace an existing mount file')
    parser.add_argument('--target-frame', default='terrain_map')
    parser.add_argument('--lidar-frame', default='unilidar_lidar')
    args = parser.parse_args()
    path = Path(args.output).expanduser()
    if path.exists() and not args.force:
        parser.error(f'{path} already exists; inspect it or use --force to replace it')
    print('Stationary mount: level target frame, floor z=0, XY origin directly under the LiDAR.')
    print('Measure from the L1 frame origin at its bottom mounting surface. Metres and radians.')
    print('Exactly inverted about X: roll=3.141592653589793, pitch=0, yaw=0. Use actual angles.')
    data = dict(parent_frame=args.target_frame, child_frame=args.lidar_frame, x=0.0, y=0.0)
    for key, prompt in [('z', 'Height above floor (m): '), ('roll', 'Roll (rad): '),
                        ('pitch', 'Pitch (rad): '), ('yaw', 'Yaw (rad): ')]:
        data[key] = ask_number(prompt)
    validate_mount(data, args.target_frame, args.lidar_frame)
    with path.open('w' if args.force else 'x') as stream:
        yaml.safe_dump(data, stream, sort_keys=False)
    print(f'Saved {path}; inspect the transformed floor before trusting terrain estimates.')


if __name__ == '__main__':
    try:
        main()
    except (EOFError, KeyboardInterrupt):
        sys.exit('Cancelled; no mount written.')
