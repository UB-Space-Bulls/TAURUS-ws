<?xml version="1.0"?>
<package format="3">
  <name>zed_gesture</name>
  <version>0.1.0</version>
  <description>URC arm-gesture intents (YOLO pose) driven by the ZED ROS 2 wrapper image stream</description>
  <maintainer email="todo@example.com">TAURUS</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <!-- ultralytics + torch are pip-installed (see urc_gesture_test.py header) -->
  <!-- zed_wrapper is only needed if you use launch_zed:=true -->

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
