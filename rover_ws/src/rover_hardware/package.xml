<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rover_hardware</name>
  <version>0.0.1</version>
  <description>ros2_control hardware interface for the swerve drivetrain's ODESC V4.2 motor controllers over CAN (ODrive CANSimple, firmware 0.5.6)</description>
  <maintainer email="lipschultzjacob@gmail.com">Space Bulls</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>

  <!-- Only for scripts/fake_odesc.py, the bench-test stand-in for real ODESCs. -->
  <exec_depend>python3-can</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
